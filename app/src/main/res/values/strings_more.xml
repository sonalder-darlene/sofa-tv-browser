    <string name="forget_player_choices">Forget my player choices</string>
    <string name="forget_player_choices_sub">Sofa Player keeps the quality, subtitles and sound you pick for the next videos. This goes back to Auto and the TV\'s own settings.</string>
    <string name="player_choices_forgotten">Player choices forgotten</string>
